# Local-only values. Production configuration is validated more strictly.
APP_ENV=local
APP_NAME=OwnSIS
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://ownsis:ownsis@localhost:5432/ownsis
DATABASE_MIGRATION_URL=postgresql+psycopg://ownsis_migration:ownsis_migration@localhost:5432/ownsis
WORKER_DATABASE_URL=postgresql+asyncpg://ownsis_worker:ownsis_worker@localhost:5432/ownsis
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY=
DEV_AUTH_ENABLED=true
DEV_AUTH_SUBJECT=dev-platform-admin
OWNID_ISSUER=
OWNID_CLIENT_ID=
OWNID_CLIENT_SECRET=
OWNID_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
OWNID_POST_LOGOUT_REDIRECT_URI=http://localhost:3000
PLATFORM_ADMIN_BOOTSTRAP_SECRET=
MOODLE_REQUEST_TIMEOUT_SECONDS=10
MCP_ENABLED=false
MCP_AUDIENCE=
MCP_RESOURCE_URL=http://localhost:8000/mcp
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=300
WORKER_MAX_ATTEMPTS=5
NEXT_PUBLIC_PRODUCT_NAME=OwnSIS
BACKEND_URL=http://localhost:8000
