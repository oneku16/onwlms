+                mutable.room_id,
+                replacement_room_id,
+                new_session.room_id,
+            }
+        ),
+        teacher_ids=frozenset(
+            {
+                *locked.teacher_ids,
+                *mutable.teacher_ids,
+                replacement_teacher_id,
+                *new_session.teacher_ids,
