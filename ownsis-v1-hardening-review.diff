+        )
+        single_connection_database = Database(
+            Settings(
+                APP_ENV=AppEnvironment.TEST,
+                DATABASE_POOL_SIZE=1,
+                DATABASE_MAX_OVERFLOW=0,
+            ),
+            database_url=test_database.runtime_dsn.replace(
+                "postgresql://",
+                "postgresql+asyncpg://",
+                1,
+            ),
