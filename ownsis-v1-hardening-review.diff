+            campus_id=model.campus_id,
+            section_code=model.section_code,
+            capacity=model.capacity,
+            meeting_windows=tuple(
+                MeetingWindow(
+                    weekday=meeting.weekday,
+                    starts_at=meeting.starts_at,
