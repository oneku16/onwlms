+    )
+    proposed_existing = replace(
+        current,
+        teacher_ids=(second_teacher_id,),
+        group_ids=(second_group_id,),
+        required_group_ids=(second_group_id,),
+        starts_at=starts_at + timedelta(hours=1),
+        ends_at=starts_at + timedelta(hours=2),
